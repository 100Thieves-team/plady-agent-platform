# Copy to terraform.tfvars and adjust before applying.
aws_region   = "ap-northeast-2"
project_name = "100thieves-wiki"

# Free-tier constrained accounts usually allow t3.micro.
instance_type = "t3.micro"
root_volume_size = 30

domain_name = "plady.kro.kr"
acme_email = "admin@plady.kro.kr"

# Optional existing EC2 key pair. Prefer SSM if possible.
# key_name = "your-key-pair-name"

# Caddy receives public HTTP/HTTPS. HTTP is needed for Let's Encrypt HTTP-01
# and redirects to HTTPS.
allowed_http_cidr_blocks  = ["0.0.0.0/0"]
allowed_https_cidr_blocks = ["0.0.0.0/0"]

# Direct container ports are closed in the HTTPS setup. Use the domain outputs.
allowed_ui_cidr_blocks = []

# MCP is protected by a bearer token proxy. Keep this restricted if possible;
# use ["0.0.0.0/0"] only when external MCP clients must reach it directly.
# allowed_mcp_cidr_blocks = ["203.0.113.10/32"]
# allowed_mcp_cidr_blocks = ["0.0.0.0/0"]
allowed_mcp_cidr_blocks = []
# allowed_ssh_cidr_blocks = ["203.0.113.10/32"]

app_dir = "/opt/plady-agent-platform"

# Recommended: SSH Deploy Keys stored as SSM SecureString values.
# App repo key: GitHub Deploy Key on 100Thieves-team/plady-agent-platform, read-only.
# Wiki data key: GitHub Deploy Key on 100Thieves-team/team-wiki-v2, allow write access.
app_repository_url                  = "git@github.com-llm-wiki-app:100Thieves-team/plady-agent-platform.git"
app_repository_ref                  = "main"
app_repo_ssh_key_ssm_parameter_name = "/100thieves/wiki/app-repo-deploy-key"

wiki_data_repository_url                  = "git@github.com-llm-wiki-data:100Thieves-team/team-wiki-v2.git"
wiki_data_repo_ssh_key_ssm_parameter_name = "/100thieves/wiki/data-repo-deploy-key"

# MCP reverse proxy bearer token. Store the actual token as SecureString.
mcp_bearer_token_ssm_parameter_name = "/100thieves/wiki/mcp-bearer-token"

# Only needed if the SecureString parameters use customer-managed KMS keys.
# app_repo_ssh_key_kms_key_arn = "arn:aws:kms:ap-northeast-2:123456789012:key/..."
# wiki_data_repo_ssh_key_kms_key_arn = "arn:aws:kms:ap-northeast-2:123456789012:key/..."
# mcp_bearer_token_kms_key_arn = "arn:aws:kms:ap-northeast-2:123456789012:key/..."

# Only needed if the AWS account already has a GitHub Actions OIDC provider.
# github_actions_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
