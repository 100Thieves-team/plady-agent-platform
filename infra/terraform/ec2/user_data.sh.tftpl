#!/bin/bash
set -euo pipefail

exec > >(tee -a /var/log/llm-wiki-bootstrap.log | logger -t llm-wiki-bootstrap -s 2>/dev/console) 2>&1

APP_DIR="${app_dir}"
APP_REPOSITORY_REF="${app_repository_ref}"
APP_REPOSITORY_URL="${app_repository_url}"
APP_REPO_SSH_KEY_SSM_PARAMETER_NAME="${app_repo_ssh_key_ssm_parameter_name}"
AWS_REGION="${aws_region}"
DOCKER_COMPOSE_VERSION="${docker_compose_version}"
ECR_REGISTRY="${ecr_registry}"
LLM_WIKI_IMAGE="${llm_wiki_image}"
WIKI_DATA_REPOSITORY_URL="${wiki_data_repository_url}"
WIKI_DATA_REPO_SSH_KEY_SSM_PARAMETER_NAME="${wiki_data_repo_ssh_key_ssm_parameter_name}"
WIKI_UI_IMAGE="${wiki_ui_image}"

APP_REPO_SSH_KEY_PATH="/home/ec2-user/.ssh/llm_wiki_app_repo"
WIKI_DATA_REPO_SSH_KEY_PATH="/home/ec2-user/.ssh/llm_wiki_data_repo"

# Base packages and Docker daemon.
dnf update -y
dnf install -y docker git ca-certificates openssh-clients
systemctl enable --now docker
usermod -aG docker ec2-user || true

# Free-tier-sized instances are memory constrained. Add swap so the first
# Docker build has a better chance of completing on t3.micro/t3.small.
if [ ! -f /swapfile ]; then
  fallocate -l 4G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=4096
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile swap swap defaults 0 0" >>/etc/fstab
fi

# GitHub CLI is still useful for manual fallback, but deploy-key bootstrap does
# not depend on it.
if dnf install -y dnf-plugins-core && dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo; then
  dnf install -y gh || echo "GitHub CLI install failed; continuing without gh."
else
  echo "GitHub CLI repo setup failed; continuing without gh."
fi

ARCH="$(uname -m)"
case "$ARCH" in
  x86_64) TOOL_ARCH="x86_64" ;;
  aarch64|arm64) TOOL_ARCH="aarch64" ;;
  *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac

# Docker Compose v2 plugin.
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v$${DOCKER_COMPOSE_VERSION}/docker-compose-linux-$${TOOL_ARCH}" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
ln -sf /usr/local/lib/docker/cli-plugins/docker-compose /usr/local/bin/docker-compose

mkdir -p "$${APP_DIR}" /home/ec2-user/.ssh
chown ec2-user:ec2-user "$${APP_DIR}" /home/ec2-user/.ssh
chmod 700 /home/ec2-user/.ssh
ssh-keyscan github.com >>/home/ec2-user/.ssh/known_hosts 2>/dev/null || true
chown ec2-user:ec2-user /home/ec2-user/.ssh/known_hosts 2>/dev/null || true
chmod 600 /home/ec2-user/.ssh/known_hosts 2>/dev/null || true

cat >/home/ec2-user/LLM_WIKI_DEPLOY.md <<DOC
# LLM Wiki deploy

This instance has Docker, Docker Compose, Git, and optionally gh installed.

## Recommended: SSH deploy-key bootstrap

If Terraform was applied with \`app_repo_ssh_key_ssm_parameter_name\`, cloud-init tries to clone the app repo automatically.
If \`wiki_data_repository_url\` and \`wiki_data_repo_ssh_key_ssm_parameter_name\` were also set, cloud-init clones the separate wiki data repo into \`$${APP_DIR}/wiki-workspace\` before starting Compose.

Check progress:

\`\`\`bash
sudo tail -f /var/log/llm-wiki-bootstrap.log
cd $${APP_DIR}
docker compose --env-file .env.ec2 -f compose.ec2.yaml ps
\`\`\`

## Manual fallback

\`\`\`bash
gh auth login
git clone https://github.com/100Thieves-team/100Thieves-wiki-mcp.git $${APP_DIR}
cd $${APP_DIR}
docker compose up -d --build
docker compose ps
\`\`\`
DOC
chown ec2-user:ec2-user /home/ec2-user/LLM_WIKI_DEPLOY.md

install_aws_cli() {
  if command -v aws >/dev/null 2>&1; then
    return 0
  fi

  dnf install -y unzip
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-$${TOOL_ARCH}.zip" -o /tmp/awscliv2.zip
  rm -rf /tmp/aws
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
}

login_to_ecr() {
  install_aws_cli
  aws ecr get-login-password --region "$${AWS_REGION}" \
    | docker login --username AWS --password-stdin "$${ECR_REGISTRY}"
}

write_ssm_secure_file() {
  parameter_name="$1"
  output_path="$2"

  install_aws_cli
  aws ssm get-parameter \
    --region "$${AWS_REGION}" \
    --name "$${parameter_name}" \
    --with-decryption \
    --query 'Parameter.Value' \
    --output text >"$${output_path}"

  chown ec2-user:ec2-user "$${output_path}"
  chmod 600 "$${output_path}"
}

append_ssh_host() {
  host_alias="$1"
  identity_file="$2"

  cat >>/home/ec2-user/.ssh/config <<CONFIG
Host $${host_alias}
  HostName github.com
  User git
  IdentityFile $${identity_file}
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new

CONFIG
  chown ec2-user:ec2-user /home/ec2-user/.ssh/config
  chmod 600 /home/ec2-user/.ssh/config
}

clone_or_update_repo() {
  repository_url="$1"
  repository_ref="$2"
  target_dir="$3"

  if [ -d "$${target_dir}/.git" ]; then
    git -C "$${target_dir}" fetch --all --prune
    git -C "$${target_dir}" checkout "$${repository_ref}"
    git -C "$${target_dir}" pull --ff-only origin "$${repository_ref}" || true
  else
    rm -rf "$${target_dir}"
    git clone --branch "$${repository_ref}" --depth 1 "$${repository_url}" "$${target_dir}"
  fi

  chown -R ec2-user:ec2-user "$${target_dir}"
}

install_wiki_data_sync() {
  cat >/usr/local/bin/llm-wiki-data-sync <<'SYNC'
#!/bin/bash
set -euo pipefail

REPO="${app_dir}/wiki-workspace"
KEY="/home/ec2-user/.ssh/llm_wiki_data_repo"
KNOWN_HOSTS="/home/ec2-user/.ssh/known_hosts"

if [ ! -d "$${REPO}/.git" ]; then
  exit 0
fi

export HOME="/root"
export GIT_SSH_COMMAND="ssh -i $${KEY} -o IdentitiesOnly=yes -o UserKnownHostsFile=$${KNOWN_HOSTS} -o StrictHostKeyChecking=accept-new"

git config --global --add safe.directory "$${REPO}" || true
git -C "$${REPO}" rev-parse --is-inside-work-tree >/dev/null 2>&1 || exit 0
git -C "$${REPO}" config user.name "llm-wiki"
git -C "$${REPO}" config user.email "llm-wiki@localhost"

if git -C "$${REPO}" rev-parse --verify HEAD >/dev/null 2>&1; then
  git -C "$${REPO}" pull --rebase --autostash origin main || true
fi

if [ -n "$(git -C "$${REPO}" status --porcelain)" ]; then
  git -C "$${REPO}" add -A
  git -C "$${REPO}" commit -m "sync: wiki data $(date -u +%Y-%m-%dT%H:%M:%SZ)" || true
fi

if git -C "$${REPO}" rev-parse --verify HEAD >/dev/null 2>&1; then
  git -C "$${REPO}" push origin HEAD:main
fi
SYNC
  chmod +x /usr/local/bin/llm-wiki-data-sync

  cat >/etc/systemd/system/llm-wiki-data-sync.service <<'SERVICE'
[Unit]
Description=Push llm-wiki data repository
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/llm-wiki-data-sync
SERVICE

  cat >/etc/systemd/system/llm-wiki-data-sync.timer <<'TIMER'
[Unit]
Description=Periodically push llm-wiki data repository

[Timer]
OnBootSec=5min
OnUnitActiveSec=1min
Persistent=true

[Install]
WantedBy=timers.target
TIMER

  systemctl daemon-reload
  systemctl enable --now llm-wiki-data-sync.timer
}

bootstrap_with_deploy_keys() {
  write_ssm_secure_file "$${APP_REPO_SSH_KEY_SSM_PARAMETER_NAME}" "$${APP_REPO_SSH_KEY_PATH}"
  append_ssh_host "github.com-llm-wiki-app" "$${APP_REPO_SSH_KEY_PATH}"

  clone_or_update_repo "$${APP_REPOSITORY_URL}" "$${APP_REPOSITORY_REF}" "$${APP_DIR}"

  if [ -n "$${WIKI_DATA_REPOSITORY_URL}" ] && [ -n "$${WIKI_DATA_REPO_SSH_KEY_SSM_PARAMETER_NAME}" ]; then
    write_ssm_secure_file "$${WIKI_DATA_REPO_SSH_KEY_SSM_PARAMETER_NAME}" "$${WIKI_DATA_REPO_SSH_KEY_PATH}"
    append_ssh_host "github.com-llm-wiki-data" "$${WIKI_DATA_REPO_SSH_KEY_PATH}"

    if [ ! -d "$${APP_DIR}/wiki-workspace/.git" ]; then
      rm -rf "$${APP_DIR}/wiki-workspace"
      git clone "$${WIKI_DATA_REPOSITORY_URL}" "$${APP_DIR}/wiki-workspace"
      chown -R ec2-user:ec2-user "$${APP_DIR}/wiki-workspace"
    fi

    install_wiki_data_sync
  fi

  cd "$${APP_DIR}"
  cat >.env.ec2 <<ENV
LLM_WIKI_IMAGE=$${LLM_WIKI_IMAGE}
WIKI_UI_IMAGE=$${WIKI_UI_IMAGE}
ENV

  if login_to_ecr && docker compose --env-file .env.ec2 -f compose.ec2.yaml pull; then
    docker compose --env-file .env.ec2 -f compose.ec2.yaml up -d
  else
    echo "ECR image pull failed; falling back to local Docker build."
    docker compose up -d --build
  fi

  if systemctl is-enabled llm-wiki-data-sync.timer >/dev/null 2>&1; then
    systemctl start llm-wiki-data-sync.service || true
  fi
}

if [ -n "$${APP_REPO_SSH_KEY_SSM_PARAMETER_NAME}" ]; then
  bootstrap_with_deploy_keys
fi
